{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend",
      "rules": [
        {
          "id": "@secretlint/secretlint-rule-database-connection-string",
          "options": {
            "allows": [
              "/postgres:\\/\\/breatic:breatic@/",
              "/postgres:\\/\\/breatic(_collab)?:(admin|collab)-pw@localhost:5432\\/breatic/",
              "/postgres:\\/\\/app:(main|yjs)-secret@test\\//"
            ]
          }
        }
      ]
    }
  ]
}
