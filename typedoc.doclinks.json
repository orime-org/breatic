{
  "$schema": "https://typedoc.org/schema.json",
  "excludeExternals": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "exclude": [
    "**/node_modules/**",
    "**/__tests__/**",
    "**/dist/**",
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  "validation": {
    "invalidLink": true,
    "notExported": false,
    "notDocumented": false
  },
  "externalSymbolLinkMappings": {
    "react-hook-form": {
      "useFormContext": "https://react-hook-form.com/docs/useformcontext"
    }
  }
}
