{
  "name": "@breatic/repo-lint",
  "private": true,
  "type": "module",
  "imports": {
    "#repo-lint/*": "./src/*.ts"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "licences": "tsx src/generate-licence-notice.ts"
  },
  "devDependencies": {
    "@breatic/eslint-rules": "workspace:*",
    "@types/node": "catalog:",
    "anti-trojan-source": "^1.12.1",
    "eslint": "catalog:",
    "minimatch": "^10.2.6",
    "plpgsql-parser": "^18.5.7",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
