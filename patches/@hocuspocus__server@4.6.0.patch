diff --git a/dist/hocuspocus-server.cjs b/dist/hocuspocus-server.cjs
index 39719e3862b1ff097c49f2673dafc445f90bd218..0aa00097d0844f8de1ad78b5b0ee2347a8a34da6 100644
--- a/dist/hocuspocus-server.cjs
+++ b/dist/hocuspocus-server.cjs
@@ -810,10 +810,18 @@ var version = "4.6.0";
 /**
 * Get parameters by the given request
 */
+// One parse per request: every pending document of a socket keeps its own
+// hook payload, so a parse per call let a client multiply its URL by that
+// count (inner#1589). Hooks share the result and must not mutate it.
+const parametersByRequest = new WeakMap();
 function getParameters(request) {
 	const url = request?.url;
 	if (!url) return new URLSearchParams();
-	return url.includes("://") ? new URL(url).searchParams : new URLSearchParams(url.split("?")[1] || "");
+	const cached = parametersByRequest.get(request);
+	if (cached) return cached;
+	const parameters = url.includes("://") ? new URL(url).searchParams : new URLSearchParams(url.split("?")[1] || "");
+	parametersByRequest.set(request, parameters);
+	return parameters;
 }
 
 //#endregion
@@ -925,7 +933,7 @@ var ClientConnection = class {
 						this.terminate(_hocuspocus_common.ResetConnection);
 						return;
 					}
-					this.incomingMessageQueue[rawKey].push(data);
+					this.incomingMessageQueue[rawKey].push(new Uint8Array(data));
 					this.incomingMessageQueueBytes[rawKey] = (this.incomingMessageQueueBytes[rawKey] ?? 0) + data.byteLength;
 					return;
 				}
