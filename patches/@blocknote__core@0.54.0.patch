+  // PATCH: carry the writer's formatting into the block being split off.
+  //
+  // `tr.split` clears the stored marks, so ending a bold line and pressing
+  // Enter drops you back to plain text — a writer laying out several
+  // emphasised lines reaches for `Mod-b` on each one, finding out only after
+  // typing that it was needed. This module knows the step: the hard-break path
+  // in `KeyboardShortcutsExtension.ts` reads the marks off the head and calls
+  // `ensureMarks`. The split path just does not take it.
+  //
+  // Which marks carry is ProseMirror's own answer rather than a list: `marks()`
+  // at a position holds the ones whose `inclusive` says typing there continues
+  // them, which is why a link — declared `inclusive: false` — is absent and a
+  // new block does not silently extend someone's URL.
+  const marks = tr.storedMarks ?? tr.doc.resolve(posInBlock).marks();
+
   tr.split(posInBlock, 2, types);
 
+  if (marks.length > 0) {
+    tr.ensureMarks(marks);
+  }
+
   return true;
 };
