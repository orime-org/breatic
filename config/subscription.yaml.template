# Template for config/subscription.yaml — membership plans.
#
# Copy this file to `config/subscription.yaml` and fill in your own figures
# and Stripe price ids. The copy is not tracked by git: it names the prices a
# deployment really charges and the Stripe objects it really sells, and
# neither belongs to anybody but the deployment that holds them.
#
# The server checks this file at startup when PAYMENT_ENABLED=true and
# refuses to start without it. It is opened once more afterwards, the first
# time a reading meets a live subscription with a period end, to judge it
# against `stale_after_days`. A deployment with no subscription rows never
# reaches that, so an install with payments off needs no copy.
#
# Every `price_cents` below is 0, which the loader's schema rejects
# (`z.number().int().positive()`). Copying this file without editing it is
# therefore refused rather than silently charging a price nobody set.
#
# One entry per subscribable tier, and inside it one per billing period.
# `base` has no entry: it is what an account falls back to when it subscribes
# to nothing, so there is nothing to sell.
#
# Separate from config/membership.yaml on purpose. That file answers "what are
# this tier's six ceilings" and its header states that every number in it is a
# plain ceiling; a price is not one. config/pricing.yaml is the other leg of
# the product entirely — credit packs bought once, not a subscription.
#
# `test` price ids are used outside production, `live` in production, the same
# split config/pricing.yaml already uses.
#
# `currency` sits on the tier rather than on each period: one tier cannot sell
# its two periods in different currencies, so putting it inside `periods`
# would be the same value written twice.
#
# An annual price must be created in Stripe with interval `year`, not with
# interval `month` and a count of 12. The two charge the same amount, and the
# reading of a Stripe subscription compares `recurring.interval` against the
# period slot a price sits in here, so the second spelling is read as a
# disagreement and the tier is refused.
plans:
  pro:
    currency: usd
    periods:
      month:
        price_cents: 0
        stripe_price_id:
          test: ""
          live: ""
      year:
        price_cents: 0
        stripe_price_id:
          test: ""
          live: ""
  team:
    currency: usd
    periods:
      month:
        price_cents: 0
        stripe_price_id:
          test: ""
          live: ""
      year:
        price_cents: 0
        stripe_price_id:
          test: ""
          live: ""

# How long a stored subscription may sit past its paid period before its tier
# stops being honoured.
#
# A subscription that is really renewing has its period pushed forward by
# Stripe, so a row still marked live long after its period ended means the
# event that ended it never reached us. Fourteen days is Stripe's own Smart
# Retries window: inside it, a subscription behind on payment is one Stripe is
# still collecting for, and taking the tier away would punish somebody whose
# card is about to go through.
stale_after_days: 14

# The bound a call to Stripe is made under, for callers that pass it.
#
# One value rather than one per caller, because what governs it is not what the
# call asks but who is waiting behind it. The SDK's own default is 80 seconds
# with two retries, so an unbounded call sits for around four minutes: a panel
# or a checkout dialog holds a person in front of a spinner, and a webhook
# holds a request Stripe has already given up on and queued a redelivery for.
#
# Five seconds is long enough for a healthy call (Stripe answers in well under
# one) and short enough that no waiter notices. The callers that pass it also
# turn retries off, for the same reason: each already has a better recovery
# than retrying inside one request — a checkout return is settled later by the
# webhook for the same purchase, a re-check before checkout
# runs again on the next press, and Stripe redelivers a failed webhook for
# three days with exponential backoff.
stripe_call_timeout_ms: 5000
