    "dotenv": "catalog:",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "sharp": "^0.34.5",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  }
}
