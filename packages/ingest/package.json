    "@cloudflare/containers": "0.3.7",
    "@sentry/cloudflare": "catalog:",
    "@mozilla/readability": "0.6.0",
    "playwright-core": "1.62.1",
    "turndown": "7.2.0",
    "unpdf": "1.1.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.12.21",
    "@cloudflare/workers-types": "^5.20260830.1",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.127.1",
    "@types/node": "catalog:",
    "@types/turndown": "5.0.6"
  }
