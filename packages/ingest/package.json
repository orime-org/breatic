{
  "name": "@breatic/ingest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "deploy:worker": "pnpm --filter @breatic/shared build && wrangler deploy --env production",
