# The MiniToolContainerGl image: the transitions export's overlap windows (frames-split design §5.4 dispatch and stitch rows,
# §7.17 transition_window row; transitions render DD of 2026-11-05).
#
# Built on the MiniToolContainerStd4 image, so FFmpeg, x264 and libvpx are exactly the ones its chunks are encoded
# with: split-and-stitch joins chunks from both images, and their codec headers must match. BASE_IMAGE names that image
# as built from packages/ingest/Dockerfile; the default is the tag packages/ingest/scripts/test-container-in-image.sh
# builds it under. Built from the repository root, like that Dockerfile.
#
# The image adds one separate program, the headless-gl renderer (container/gl-renderer/render.mjs), with its own
# node_modules: headless-gl (`gl`, a native module), `gl-transition` and the `gl-transitions` shaders, at the versions
# packages/web/package.json pins, so the export draws the preview's shaders. The service still loads only Node
# built-ins and this repository's code (packages/ingest/AGENTS.md#two-runtimes). WebGL runs on Mesa's llvmpipe under Xvfb, which the
# image starts itself (`xvfb-run` hangs on Alpine, per the DD).
ARG BASE_IMAGE=breatic-ingest-media-test:local

# headless-gl publishes no binary for Node 24 (ABI 137) or musl arm64, so it is compiled from source here (node-gyp and
# its bundled ANGLE); only the installed directory reaches the image. The builder is the Node 24 musl image, the ABI of
# the base image's Alpine nodejs=~24.
FROM node:24-alpine3.23 AS gl
ARG BUILD_JOBS=2
RUN apk add --no-cache python3 build-base pkgconf libx11-dev libxext-dev libxi-dev mesa-dev
WORKDIR /app/gl-renderer
COPY packages/web/package.json /tmp/web-package.json
RUN set -eu; \
  transition=$(node -p "require('/tmp/web-package.json').dependencies['gl-transition']"); \
  transitions=$(node -p "require('/tmp/web-package.json').dependencies['gl-transitions']"); \
  echo '{"name":"gl-renderer","private":true,"type":"module"}' > package.json; \
  JOBS="$BUILD_JOBS" npm install --no-audit --no-fund --save-exact gl@8.1.6 "gl-transition@$transition" "gl-transitions@$transitions"
COPY packages/ingest/container/gl-renderer/render.mjs ./render.mjs

FROM ${BASE_IMAGE}
RUN apk add --no-cache libx11 libxext libxcb libdrm zlib xvfb mesa-gl mesa-dri-gallium
COPY --from=gl /app/gl-renderer /app/gl-renderer

# What the renderer brings and under what terms (THIRD-PARTY.md "The transition renderer"), read out of the installed
# packages and modules while the image is built, beside the media programs' records.
RUN set -eu; \
  mkdir -p /usr/share/gl-renderer-source; \
  for module in gl gl-transition gl-transitions; do \
    for licence in /app/gl-renderer/node_modules/$module/LICENSE*; do \
      cp -R "$licence" "/usr/share/gl-renderer-source/$module-$(basename "$licence")"; \
    done; \
  done; \
  { \
    echo "The transition renderer's modules (npm), with their declared licences:"; \
    for module in gl gl-transition gl-transitions; do \
      node -e "const p=require('/app/gl-renderer/node_modules/$module/package.json'); console.log('  ' + p.name + ' ' + p.version + ', ' + p.license)"; \
    done; \
    echo; \
    echo "The Alpine packages this image adds to its base, every one the renderer pulls in (version, licence, exact recipe commit):"; \
    apk info -vv 2>/dev/null | sed 's/ - .*//' | sort > /tmp/after; \
    sed 's/ - .*//' /opt/opencv/build-record/runtime-apk-packages.txt | sort > /tmp/before; \
    comm -13 /tmp/before /tmp/after | while read -r installed; do \
      p=$(awk -v want="$installed" '/^P:/{name=substr($0,3)} /^V:/{if (name "-" substr($0,3) == want) print name}' /lib/apk/db/installed); \
      info=$(awk "/^P:$p\$/,/^\$/" /lib/apk/db/installed); \
      echo "  $p $(printf '%s\n' "$info" | sed -n 's/^V://p'), $(printf '%s\n' "$info" | sed -n 's/^L://p'), aports $(printf '%s\n' "$info" | sed -n 's/^c://p')"; \
    done; \
  } > /usr/share/gl-renderer-source/SOURCE

# What this image distributes and under what terms, where the media container keeps it.
COPY THIRD-PARTY.md /usr/share/doc/breatic/THIRD-PARTY.md

ENV DISPLAY=:99
CMD ["/bin/sh", "-c", "Xvfb :99 -screen 0 1280x720x24 -nolisten tcp >/dev/null 2>&1 & exec node /app/server.mjs"]

# As in packages/ingest/Dockerfile: which copy of the repository built this image, set by `image_vars` in a local
# wrangler.toml and empty for a deploy.
ARG DEV_COPY=
LABEL org.breatic.dev-copy=$DEV_COPY
