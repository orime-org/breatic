{
  // The container runs on Node, not on workerd: it spawns ffprobe and ffmpeg
  // and serves HTTP off `node:http`. The package's own tsconfig describes the
  // Worker's runtime — workers-types, no Node — so this directory needs its
  // own, or the service is a file nothing typechecks.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023"],
    "types": ["node"],
    "baseUrl": "..",
    "paths": {
      "@ingest/container/*": ["./container/*"],
      "@ingest/*": ["./src/*"],
      "@shared/*": ["../shared/src/*"]
    }
  },
  // Named one by one: this is the whole of what the container shares with the
  // Worker. tsc and esbuild follow an import past this list on their own, so
  // the list is held by breatic/media-container-own-code-only, which reports
  // any @ingest/ import of a module not named here. The Worker's own entry is
  // not in the list — it describes workerd, which this environment is not.
  "include": [
    "*.ts",
    "./analysis-frame-reader.ts",
    "./assemble-video-source-ledger.ts",
    "./iso-bmff-metadata.ts",
    "./matroska-metadata.ts",
    "./iso-bmff-presentation.ts",
    "./presentation-run.ts",
    "./stream-window.ts",
    "./served-object-read.ts",
    "./run-tool.ts",
    "./presentation-recipes.ts",
    "./plan-command.ts",
    "./plan-run.ts",
    "./mini-tool-run.ts",
    "./physical-video-probe.ts",
    "./analysis-pipeline.ts",
    "./analysis-detection.ts",
    "./lipsync-recipes.ts",
    "./model-recipes.ts",
    "./rle-track.ts",
    "../../shared/src/mini-tools/model-grid.ts",
    "../../shared/src/mini-tools/coco-rle.ts",
    "../../shared/src/mini-tools/lipsync-timeline.ts",
    "../src/jobs/container-report.ts",
    "../../shared/src/upload/mini-tool-plan-types.ts",
    "../src/probe-answer.ts",
    "../src/presentation-run-types.ts",
    "../src/video-alpha-classification.ts",
    "../src/probe-command.ts",
    "../src/media-metadata.ts",
    "../src/shown-picture.ts",
    "../src/long-media-measured-window.ts",
    "../src/png-size.ts",
    "../src/preview-step.ts",
    "../src/peaks-step.ts",
    "../src/upright-run.ts",
    "../src/object-url.ts",
    "../src/jobs/op-args.ts",
    "../../shared/src/adjust-value.ts",
    "../../shared/src/audio-eq.ts",
    "../../shared/src/audio-denoise.ts",
    "../../shared/src/audio-dynamics.ts",
    "../../shared/src/audio-peaks.ts",
    "../../shared/src/upload/agent-picture-types.ts",
    "../../shared/src/media/long-media-job-types.ts",
    "../../shared/src/mini-tools/types.ts",
    "../../shared/src/upload/video-presentation-types.ts",
    "../../shared/src/upload/video-source-ledger-types.ts",
    "../../shared/src/mini-tools/video-presentation-projection.ts",
    "../../shared/src/mini-tools/video-presentation-timeline.ts",
    "../../shared/src/mini-tools/video-encode-plan.ts",
    "../../shared/src/mini-tools/canonical-json.ts",
    "../../shared/src/upload/video-presentation-keys.ts",
    "__tests__/*.ts"
  ]
}
