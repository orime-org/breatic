{
  // The container runs on Node, not on workerd: it spawns ffprobe and ffmpeg
  // and serves HTTP off `node:http`. The package's own tsconfig describes the
  // Worker's runtime — workers-types, no Node — so this directory needs its
  // own, or the service is a file nothing typechecks.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023"],
    "types": ["node"],
    "baseUrl": "..",
    "paths": {
      "@ingest/*": ["./src/*"]
    }
  },
  // Named one by one: this is the whole of what the container shares with the
  // Worker. tsc and esbuild follow an import past this list on their own, so
  // the list is held by breatic/media-container-own-code-only, which reports
  // any @ingest/ import of a module not named here. The Worker's own entry is
  // not in the list — it describes workerd, which this environment is not.
  "include": [
    "*.ts",
    "../src/probe-answer.ts",
    "../src/probe-command.ts",
    "../src/media-metadata.ts",
    "../src/preview-step.ts",
    "__tests__/*.ts"
  ]
}
