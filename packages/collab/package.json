{
  "name": "@breatic/collab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --clean --sourcemap",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@breatic/core": "workspace:*",
    "@breatic/shared": "workspace:*",
    "@hocuspocus/extension-redis": "catalog:",
    "@hocuspocus/server": "catalog:",
    "@sentry/node": "catalog:",
    "@sesamecare-oss/redlock": "^1.4.0",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "lib0": "catalog:",
    "y-protocols": "catalog:",
    "yaml": "catalog:",
    "yjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@breatic/integration-tests": "workspace:*",
    "@testcontainers/postgresql": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "fast-check": "catalog:",
    "testcontainers": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:",
    "ws": "catalog:"
  }
}
