{
  "name": "@breatic/collab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --clean",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@breatic/core": "workspace:*",
    "@breatic/shared": "workspace:*",
    "@hocuspocus/extension-database": "^3.4.4",
    "@hocuspocus/extension-redis": "^3.4.4",
    "@hocuspocus/extension-throttle": "^3.4.4",
    "@hocuspocus/server": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "lib0": "catalog:",
    "y-protocols": "catalog:",
    "yaml": "catalog:",
    "yjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  }
}
