{
  "name": "@breatic/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "catalog:",
    "@ai-sdk/google": "catalog:",
    "@ai-sdk/openai": "catalog:",
    "@aws-sdk/client-s3": "^3.1107.0",
    "@aws-sdk/s3-request-presigner": "^3.1107.0",
    "@breatic/shared": "workspace:*",
    "ai": "catalog:",
    "ali-oss": "catalog:",
    "bcryptjs": "catalog:",
    "bullmq": "catalog:",
    "drizzle-orm": "catalog:",
    "file-type": "^22.0.1",
    "google-auth-library": "catalog:",
    "ioredis": "5.10.1",
    "ipaddr.js": "catalog:",
    "nodemailer": "catalog:",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "postgres": "catalog:",
    "stripe": "catalog:",
    "yaml": "catalog:",
    "yjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
    "@types/node": "catalog:",
    "@types/nodemailer": "catalog:",
    "dotenv": "catalog:",
    "drizzle-kit": "^0.31.10",
    "fast-check": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  }
}
