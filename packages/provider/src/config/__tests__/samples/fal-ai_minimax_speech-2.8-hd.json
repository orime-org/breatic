      "title": "Voice Id",
      "minLength": 1,
      "default": "Wise_Woman",
      "type": "string",
      "description": "Predefined voice ID to use for synthesis"
     },
     "speed": {
      "type": "number",
      "title": "Speed",
      "maximum": 2,
      "default": 1,
      "minimum": 0.5,
      "description": "Speech speed (0.5-2.0)"
