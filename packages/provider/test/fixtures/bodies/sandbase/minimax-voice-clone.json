{
  "model": "minimax-voice-clone",
  "upstream": "sandbase",
  "model_id": "minimax/voice-clone",
  "runs": [
    {
      "params": {
        "model": "speech-2.8-hd",
        "need_noise_reduction": true
      },
      "prompt": "a red fox running through fresh snow at dawn",
      "body": {
        "noise_reduction": true,
        "mode": "async",
        "accuracy": 0.7
      }
    },
    {
      "params": {
        "model": "speech-2.8-hd",
        "need_noise_reduction": true,
        "audio": "https://example.com/sample.png"
      },
      "prompt": "a red fox running through fresh snow at dawn",
      "body": {
        "noise_reduction": true,
        "audio": "https://example.com/sample.png",
        "mode": "async",
        "accuracy": 0.7
      }
    }
  ],
  "steps": [
    {
      "kind": "speak",
      "endpoint": "minimax/speech/2.8/hd",
      "context": {
        "source": "https://example.com/sample.png",
        "params": {
          "model": "speech-2.8-hd",
          "need_noise_reduction": true
        },
        "prompt": "a red fox running through fresh snow at dawn",
        "customVoiceId": "BreaticSample",
        "voiceId": "voice-sample",
        "itemIndex": null
      },
      "body": {
        "text": "a red fox running through fresh snow at dawn",
        "voice_id": "voice-sample"
      }
    }
  ]
}
