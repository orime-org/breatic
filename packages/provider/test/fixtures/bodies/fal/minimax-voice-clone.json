{
  "model": "minimax-voice-clone",
  "upstream": "fal",
  "model_id": "fal-ai/minimax/voice-clone",
  "runs": [
    {
      "params": {
        "model": "speech-2.8-hd",
        "need_noise_reduction": true,
        "audio": "https://example.com/audio.mp3"
      },
      "prompt": "a red fox running through fresh snow at dawn",
      "body": {
        "audio_url": "https://example.com/audio.mp3",
        "noise_reduction": true,
        "accuracy": 0.7
      }
    }
  ],
  "steps": [
    {
      "kind": "speak",
      "endpoint": "fal-ai/minimax/speech-2.8-hd",
      "context": {
        "source": "https://example.com/sample.png",
        "params": {
          "model": "speech-2.8-hd",
          "need_noise_reduction": true,
          "audio": "https://example.com/audio.mp3"
        },
        "prompt": "a red fox running through fresh snow at dawn",
        "customVoiceId": "BreaticSample",
        "voiceId": "voice-sample",
        "itemIndex": null
      },
      "body": {
        "prompt": "a red fox running through fresh snow at dawn",
        "voice_setting": {
          "voice_id": "voice-sample",
          "emotion": "happy"
        },
        "normalization_setting": {
          "enabled": false
        }
      }
    }
  ]
}
