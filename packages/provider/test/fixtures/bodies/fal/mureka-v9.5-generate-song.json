{
  "model": "mureka-v9.5-generate-song",
  "upstream": "fal",
  "model_id": "mureka/v9.5/generate/song",
  "runs": [
    {
      "params": {
        "song": "https://example.com/sample.mp3"
      },
      "prompt": "a red fox running through fresh snow at dawn",
      "ids": {
        "song": "upload_reference-id"
      },
      "body": {
        "reference_id": "upload_reference-id",
        "prompt": "a red fox running through fresh snow at dawn"
      }
    },
    {
      "params": {
        "song": "https://example.com/sample.mp3",
        "lyrics": "sample text"
      },
      "prompt": "a red fox running through fresh snow at dawn",
      "ids": {
        "song": "upload_reference-id"
      },
      "body": {
        "lyrics": "sample text",
        "reference_id": "upload_reference-id",
        "prompt": "a red fox running through fresh snow at dawn"
      }
    },
    {
      "params": {
        "song": "https://example.com/sample.mp3",
        "vocal": "https://example.com/sample.mp3"
      },
      "prompt": "a red fox running through fresh snow at dawn",
      "ids": {
        "song": "upload_reference-id",
        "vocal": "vocal-id"
      },
      "body": {
        "reference_id": "upload_reference-id",
        "vocal_id": "vocal-id",
        "prompt": "a red fox running through fresh snow at dawn"
      }
    }
  ],
  "untaken": [
    {
      "param": "melody",
      "value": "https://example.com/sample.mp3"
    }
  ],
  "steps": [
    {
      "kind": "upload_reference",
      "endpoint": "mureka/api/files/upload",
      "context": {
        "source": "https://example.com/sample.png",
        "params": {
          "song": "https://example.com/sample.mp3"
        },
        "prompt": "a red fox running through fresh snow at dawn",
        "customVoiceId": "BreaticSample",
        "voiceId": "voice-sample",
        "itemIndex": null,
        "param": "song"
      },
      "body": {
        "file_url": "https://example.com/sample.png",
        "purpose": "reference"
      }
    },
    {
      "kind": "upload_melody",
      "endpoint": "mureka/api/files/upload",
      "context": {
        "source": "https://example.com/sample.png",
        "params": {
          "song": "https://example.com/sample.mp3"
        },
        "prompt": "a red fox running through fresh snow at dawn",
        "customVoiceId": "BreaticSample",
        "voiceId": "voice-sample",
        "itemIndex": null,
        "param": "melody"
      },
      "body": {
        "file_url": "https://example.com/sample.png",
        "purpose": "melody"
      }
    },
    {
      "kind": "vocal",
      "endpoint": "mureka/api/voice/clone",
      "context": {
        "source": "https://example.com/sample.png",
        "params": {
          "song": "https://example.com/sample.mp3"
        },
        "prompt": "a red fox running through fresh snow at dawn",
        "customVoiceId": "BreaticSample",
        "voiceId": "voice-sample",
        "itemIndex": null,
        "param": "vocal"
      },
      "body": {
        "audio_url": "https://example.com/sample.png"
      }
    }
  ]
}
