{
  "name": "@breatic/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./src/index.ts"
    },
    "./page-links": {
      "import": "./dist/agent/page-links.js",
      "types": "./src/agent/page-links.ts"
    },
    "./still-running": {
      "import": "./dist/task/still-running.js",
      "types": "./src/task/still-running.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/agent/page-links.ts src/task/still-running.ts --format esm --clean --sourcemap",
    "dev": "tsup src/index.ts src/agent/page-links.ts src/task/still-running.ts --format esm --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@breatic/core": "workspace:*",
    "@breatic/provider": "workspace:*",
    "@breatic/shared": "workspace:*",
    "ai": "catalog:",
    "drizzle-orm": "catalog:",
    "ipaddr.js": "catalog:",
    "mjml": "5.4.1",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "catalog:",
    "@types/mjml": "5.0.0",
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "testcontainers": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  }
}
