{
  "name": "@breatic/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --clean",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@breatic/core": "workspace:*",
    "@breatic/domain": "workspace:*",
    "@breatic/shared": "workspace:*",
    "@hono/node-server": "^2.1.0",
    "@hono/zod-validator": "^0.7.6",
    "ai": "catalog:",
    "bcryptjs": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "google-auth-library": "catalog:",
    "hono": "^4.13.1",
    "prom-client": "^14.2.0",
    "stripe": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@breatic/collab": "workspace:*",
    "@breatic/worker": "workspace:*",
    "@hocuspocus/extension-redis": "catalog:",
    "@hocuspocus/server": "catalog:",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/node": "catalog:",
    "bullmq": "catalog:",
    "fast-check": "catalog:",
    "postgres": "catalog:",
    "testcontainers": "^11.14.0",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:",
    "yjs": "catalog:"
  }
}
