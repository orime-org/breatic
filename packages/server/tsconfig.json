{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@server/*": ["./src/*"],
      "@shared/*": ["../shared/src/*"],
      "@core/*": ["../core/src/*"],
      "@domain/*": ["../domain/src/*"],
      "@provider/*": ["../provider/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "vitest.config.ts",
    "vitest.integration.config.ts"
  ]
}
