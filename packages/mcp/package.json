{
  "name": "@breatic/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --clean --sourcemap",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@breatic/core": "workspace:*",
    "@breatic/shared": "workspace:*",
    "@hono/node-server": "^2.1.0",
    "@modelcontextprotocol/hono": "2.0.2",
    "@modelcontextprotocol/server": "2.4.0",
    "dotenv": "catalog:",
    "hono": "^4.13.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@breatic/integration-tests": "workspace:*",
    "@testcontainers/postgresql": "catalog:",
    "@types/node": "catalog:",
    "testcontainers": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  }
}
