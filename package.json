{
  "name": "breatic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "dev:server": "pnpm --filter @breatic/server dev",
    "dev:collab": "pnpm --filter @breatic/collab dev",
    "dev:worker": "pnpm --filter @breatic/worker dev",
    "start": "node packages/server/dist/index.js",
    "start:collab": "node packages/collab/dist/index.js",
    "start:worker": "node packages/worker/dist/index.js",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "lint:repo": "pnpm --filter @breatic/repo-lint start",
    "lint:dependency-cruiser": "depcruise --config .dependency-cruiser.cjs packages/*/src eslint-rules/src repo-lint/src",
    "typecheck": "turbo run typecheck",
    "docs": "turbo run docs",
    "clean": "turbo run clean",
    "prepare": "git config core.hooksPath .husky || true"
  },
  "devDependencies": {
    "@breatic/eslint-rules": "workspace:*",
    "@eslint/js": "catalog:",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.2",
    "dependency-cruiser": "^17.4.3",
    "eslint": "catalog:",
    "globals": "catalog:",
    "eslint-plugin-drizzle": "^0.2.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "catalog:",
    "secretlint": "^13.0.2",
    "tsx": "catalog:",
    "turbo": "^2.4.0",
    "typedoc": "^0.28.18",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "overrides": {
      "ioredis": "5.10.1"
    }
  }
}
